# =============================================================================
# Sentinel Memory — environment configuration
#
# Copy to .env.local (git-ignored) and fill in. Nothing here is read by the
# browser: every value is server-side only, and the project defines no
# NEXT_PUBLIC_* variable, so no secret can be inlined into the client bundle.
#
# The app runs with NONE of these set — it falls back to an in-memory demo
# store and local rule-based reasoning, and labels both clearly in the UI.
# =============================================================================

# -----------------------------------------------------------------------------
# CockroachDB — REQUIRED for the real integration
# -----------------------------------------------------------------------------
# From CockroachDB Cloud: Cluster → Connect → "General connection string".
# Without it the app uses the in-memory demo store and says so on every page.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/sentinel?sslmode=verify-full

# -----------------------------------------------------------------------------
# Amazon Bedrock — REQUIRED for real model reasoning
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1

# Optional. Omit both to use the default AWS provider chain (IAM role, SSO
# profile, container credentials). Only set these for static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials.
AWS_SESSION_TOKEN=

# Any Bedrock text model you have access to. Called through the Converse API,
# so the application code is model-agnostic. Check availability with:
#   aws bedrock list-foundation-models --region "$AWS_REGION"
# Examples (use whichever your account has access to in your region):
#   anthropic.claude-3-5-sonnet-20241022-v2:0
#   us.anthropic.claude-3-5-haiku-20241022-v1:0
#   amazon.nova-pro-v1:0
#   meta.llama3-1-70b-instruct-v1:0
BEDROCK_MODEL_ID=

# Optional. A Bedrock embedding model for vector memory. If unset, Sentinel
# uses a deterministic local embedder (a hashed-feature projection, NOT a
# learned model) and labels it as a fallback everywhere it appears.
#   amazon.titan-embed-text-v2:0   -> 1024 dimensions
#   amazon.titan-embed-text-v1     -> 1536 dimensions
#   cohere.embed-english-v3        -> 1024 dimensions
BEDROCK_EMBEDDING_MODEL_ID=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Vector width stored in CockroachDB. MUST match the embedding model above.
# The migration is templated with this value, so changing it requires re-running
# `npm run db:migrate -- --drop && npm run db:seed`.
EMBEDDING_DIMENSIONS=1024

# Shows a "Demo Mode" badge and the seeded quick-action buttons. It does NOT
# fake any integration: when DATABASE_URL and Bedrock are configured, demo mode
# still uses the real services.
DEMO_MODE=true

# Maximum length of any free-text field accepted by the API.
MAX_CONTENT_LENGTH=2000

# Per-IP requests per minute (in-process fixed window; single instance only).
RATE_LIMIT_PER_MINUTE=60

# Name attributed to manual actions in the UI and on the audit trail.
DEFAULT_RESPONDER=A. Reyes (Shift Lead)

# =============================================================================
# NOT an application variable — do not put this in .env.local
#
# The CockroachDB Cloud Managed MCP Server is a developer/operator tool, not
# part of the request path. Its token lives in your MCP client configuration.
# See docs/MCP.md and mcp/ for setup.
# =============================================================================
